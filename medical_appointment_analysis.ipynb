import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
df = pd.read_excel(
    r"C:\Users\Vykunta Reddy\Documents\Codex\2026-10-23\if-b4-if-countif-c-4\outputs\Practice-Data-Medical-Appointments.xlsx",
    sheet_name="Medical Appointments"
)

print(df.head())
print(df.shape)
print(df.isna().sum())
print(df.duplicated().sum())
print(df["AppointmentID"].duplicated().sum())
print(df["Age"].min(),"to",df["Age"].max())
df.loc[
    (df["Age"] < 0)
    | (df["Age"] > 100)
    | (df["ScheduledDay"] > df["AppointmentDay"]),
    ["AppointmentID", "ScheduledDay", "AppointmentDay", "Age"]
]
df_clean = df.drop_duplicates().copy()

df_clean = df_clean[
    (df_clean["Age"] >= 0)
    & (df_clean["Age"] <= 100)
    & (df_clean["ScheduledDay"] <= df_clean["AppointmentDay"])
].copy()

print("Rows before:", len(df))
print("Rows after:", len(df_clean))
df_clean["NoShowFlag"] = (
    df_clean["No-show"].str.strip().str.lower() == "yes"
).astype(int)

print(df_clean[["No-show", "NoShowFlag"]].head())
# Overall rate
overall_rate = df_clean["NoShowFlag"].mean() * 100
print(f"Overall no-show rate: {overall_rate:.2f}%")
sms_summary = (
    df_clean.groupby("SMS_received")["NoShowFlag"]
    .agg(["count", "mean"])
    .reset_index()
)

sms_summary["no_show_rate_pct"] = sms_summary["mean"] * 100
print(sms_summary)
import seaborn as sns
import matplotlib.pyplot as plt

sns.barplot(data=sms_summary, x="SMS_received", y="no_show_rate_pct")
plt.title("No-show rate by SMS reminder")
plt.xlabel("SMS received (0 = No, 1 = Yes)")
plt.ylabel("Appointments missed (%)")
plt.tight_layout()
plt.show()
gender_summary = (
    df_clean.groupby("Gender")["NoShowFlag"]
    .agg(["count", "mean"])
    .reset_index()
)
gender_summary["no_show_rate_pct"] = gender_summary["mean"] * 100

print(gender_summary)
